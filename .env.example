# ==============================================================================
# DAVIZ Solutions CRM — Environment Configuration Template
# Copy this file to .env (or .env.local) and fill in your values.
# NEVER commit .env or any secret keys to GitHub or public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth Configuration
# Obtain from your Supabase Dashboard: Settings > API
# ------------------------------------------------------------------------------
# Frontend / Client-side accessible variables (prefixed with VITE_ for Vite build)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend / Serverless function variables (can also be read by /api routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Email OTP Verification (Google Apps Script Web App)
# Used for sending 6-digit OTP codes via Gmail
# ------------------------------------------------------------------------------
# The Web App URL generated from Deploy > New deployment (Web app)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Shared HMAC secret for verifying serverless-to-Apps-Script requests (generate a 64-char hex string)
GOOGLE_APPS_SCRIPT_SHARED_SECRET=your_secure_random_hmac_secret_here
CRM_HMAC_SECRET=your_secure_random_hmac_secret_here

# ------------------------------------------------------------------------------
# 3. Regional & Enterprise Localization
# ------------------------------------------------------------------------------
VITE_COMPANY_NAME="DAVIZ Solutions"
VITE_DEFAULT_TIMEZONE="Asia/Dubai"
VITE_DEFAULT_CURRENCY="AED"

# ------------------------------------------------------------------------------
# 4. Optional Direct Database Connection (for SQL migrations)
# ------------------------------------------------------------------------------
# POSTGRES_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# POSTGRES_PASSWORD=your_database_password
